# 复制本文件为 .env 并填入你自己的值。.env 不会被提交到 Git。
# 切换到真实 Bedrock 实现
LLM_IMPL=bedrock
EMBEDDER_IMPL=bedrock
# AWS 凭证（用你自己的 IAM 密钥；也可改用 ~/.aws/credentials，则这里可留空）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
# Bedrock 模型（可选，默认即以下值）
BEDROCK_LLM_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024

# 用 Gemini(Google AI Studio) 作为 LLM:
# LLM_IMPL=gemini
# GEMINI_API_KEY=你在 https://aistudio.google.com/apikey 生成的 key
# GEMINI_MODEL=gemini-flash-latest
# 注意：免费层每个模型每天请求配额有限（如某些模型仅 20 次/天），
# 推荐理由已改为「一次调用批量生成」以节省配额；配额耗尽会回退到英文模板。
